{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "module": "nodenext",
    "target": "esnext",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
