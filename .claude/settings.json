{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "15000",
    "BASH_MAX_TIMEOUT_MS": "15000"
  },
  "cleanupPeriodDays": 180,
  "idleCompaction": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/read-confirm.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/read-confirm.sh\"; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/read-confirm.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact|clear|startup",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/restore-compact-state.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/restore-compact-state.sh\"; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/restore-compact-state.sh\"",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/restore-compact-state.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/restore-compact-state.sh\"; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/restore-compact-state.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/save-compact-state.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/save-compact-state.sh\"; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/save-compact-state.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^([A-Za-z0-9_.-]+:)?(ccweb-prompt|state-audit|chat-handoff|controller-mode)$",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-rule-read.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-rule-read.sh\"; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-rule-read.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit|Agent|Task|Workflow|Skill|mcp__.*[Gg]it[Hh]ub.*",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-rule-read.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-rule-read.sh\"; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-rule-read.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-kill.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-kill.sh\"; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-kill.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-shared-tmp.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-shared-tmp.sh\"; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-shared-tmp.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/record-rule-read.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/record-rule-read.sh\"; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/record-rule-read.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/remind-before-compact.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/remind-before-compact.sh\"; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/remind-before-compact.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-receipt.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-receipt.sh\"; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-receipt.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-announce-end.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-announce-end.sh\"; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-announce-end.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "[ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-announce-end.sh\" ] || exit 0; [ -n \"$BASH_VERSION\" ] || exec bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-announce-end.sh\" --rewake; . \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-announce-end.sh\" --rewake",
            "timeout": 660,
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
