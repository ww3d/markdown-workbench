# Everything except the bundles, manifest, media and docs the Marketplace
# renders. node_modules is excluded because the bundles are self-contained:
# dist/extension.cjs carries the host sources, dist/webview.js and
# dist/webview.css the webview's (loaded at runtime via asWebviewUri, like
# the codicon font in media/); src/ ships in neither form.
.github/**
docs/**
tests/**
bench/**
node_modules/**
src/**
Build.cmd
Restore.cmd
Test.cmd
build.sh
restore.sh
test.sh
publish.ps1
tsdown.config.ts
tsconfig*.json
pnpm-lock.yaml
pnpm-workspace.yaml
biome.json
.prettierignore
.gitattributes
.gitignore
.vscodeignore
*.vsix
# Build outputs other than dist/ (eng/layout.ts).
artifacts/**
# The repo-local toolchain the bootstrap fetches (eng/common): Node and pnpm, never part of the extension.
.tools/**
# Repo records of the state audit, not extension content.
audit/**
backlog.md
# Repo tooling that is no part of the extension: build/release scripts, the
# output layout (eng/), the files synced from the playbook and local agent
# scratch space.
scripts/**
eng/**
.agent/**
.agents/**
.claude/**
tech/**
AGENTS.md
CLAUDE.md
.playbook-version
# Exclude only the 256px design master; every other media/*.svg is a runtime
# asset (tab-action command icons, webview glyphs) that must ship in the vsix.
# This used to be an allowlist (exclude media/*.svg, re-add named files), but a
# forgotten negation silently dropped new icons from the package. Excluding the
# single source instead fails safe: at worst the package carries one file too
# many, never one too few. The Marketplace icon is media/icon.png.
media/icon.svg
