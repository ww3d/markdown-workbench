{
  "playbookVersion": "25.60.0",
  "rules": [
    {
      "trigger": "agents",
      "path": ".agents/rules/agents.md",
      "readBefore": "starting a sub-agent or a session",
      "budgetTokens": 1200
    },
    {
      "trigger": "audit",
      "path": ".agents/rules/audit.md",
      "readBefore": "starting a new slice or design round, running a state audit, or syncing from or diverging from a source",
      "budgetTokens": 2200
    },
    {
      "trigger": "carrier",
      "path": ".agents/rules/carrier.md",
      "readBefore": "deferring a point, or setting a closing keyword",
      "budgetTokens": 4000
    },
    {
      "trigger": "chat",
      "path": ".agents/rules/chat.md",
      "readBefore": "the first answer to the maintainer",
      "budgetTokens": 1000
    },
    {
      "trigger": "code",
      "path": ".agents/rules/code.md",
      "readBefore": "writing code",
      "budgetTokens": 2650
    },
    {
      "trigger": "controller",
      "path": ".agents/rules/controller.md",
      "readBefore": "steering sessions as controller or orchestrator, or commissioning, mediating or merging a pull request",
      "budgetTokens": 3700
    },
    {
      "trigger": "docs",
      "path": ".agents/rules/docs.md",
      "readBefore": "touching a doc or a timestamped file",
      "budgetTokens": 800
    },
    {
      "trigger": "evidence",
      "path": ".agents/rules/evidence.md",
      "readBefore": "claiming something is done, green, or measured",
      "budgetTokens": 450
    },
    {
      "trigger": "pr",
      "path": ".agents/rules/pr.md",
      "readBefore": "opening or maintaining a pull request",
      "budgetTokens": 3500
    },
    {
      "trigger": "review",
      "path": ".agents/rules/review.md",
      "readBefore": "posting a review",
      "budgetTokens": 1700
    },
    {
      "trigger": "session",
      "path": ".agents/rules/session.md",
      "readBefore": "giving the read receipt by hand, or receiving a pasted text with a version line",
      "budgetTokens": 1300
    }
  ]
}
