{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!AGENTS.md",
      "!.agents/rules",
      "!.claude",
      "!docs/common",
      "!tech/common",
      "!scripts/common",
      "!.playbook-version",
      "!media/morphdom.js"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "useAwait": "error"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      // The media SVGs are command and tab icons VS Code loads as image files;
      // a <title> inside them reaches no reader.
      "includes": ["media/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      // webview.css is ordered by component, and 13 of its rules come after a
      // more specific one on the same element. Reordering them is not provably
      // cascade-neutral (rules of equal specificity would move too) and the
      // headless tests do not render, so the order stays.
      "includes": ["media/webview.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
